        <!-- app.py module -->
        <mxCell id="app_mod" value="&lt;b&gt;app.py&lt;/b&gt;&#xa;—————————————&#xa;+ SECRET_KEY: str&#xa;+ TOKEN_SALT: str&#xa;+ serializer: URLSafeTimedSerializer&#xa;+ app: Flask&#xa;+ recommender: TravelRecommender&#xa;—————————————&#xa;+ create_token(user_id) → str&#xa;+ decode_token(token) → int|None&#xa;+ get_current_user_id() → int|None&#xa;+ health() → JSON&#xa;+ register() → JSON&#xa;+ login() → JSON&#xa;+ add_interaction() → JSON&#xa;+ cascade_recommendations() → JSON&#xa;+ demo_recommendations() → JSON" style="shape=mxgraph.basic.rect;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="260" height="270" as="geometry"/>
        </mxCell>

        <!-- db.py module -->
        <mxCell id="db_mod" value="&lt;b&gt;db.py&lt;/b&gt;&#xa;—————————————&#xa;+ DB_PATH: Path&#xa;—————————————&#xa;+ get_connection() → Connection&#xa;+ init_db() → None&#xa;&#xa;Tables:&#xa;  users(id, username, email,&#xa;    password_hash, age, is_biker,&#xa;    home_city, home_lat, home_lng)&#xa;  interactions(id, user_id,&#xa;    place_id, interaction_type)" style="shape=mxgraph.basic.rect;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
